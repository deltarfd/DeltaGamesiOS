# macOS
.DS_Store

# Xcode
DerivedData/
*.xcuserstate
**/xcuserdata/

# Swift Package Manager
.build/
Packages/**/.build/

# CocoaPods temporary files
Pods/Local Podspecs/

# Logs and coverage
