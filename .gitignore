*.xcresult
coverage/

# Secrets & API Keys
# NOTE: Do NOT commit actual API keys. Use environment variables in CI/CD.
# RawgAPI.plist is tracked but should only contain PLACEHOLDER values.
# Actual API key is injected via RAWG_API_KEY environment variable.
env.local
.env
.env.local
*.key
*.pem

