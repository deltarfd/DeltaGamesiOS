# macOS
.DS_Store

# Xcode
DerivedData/
*.xcuserstate
**/xcuserdata/

# Swift Package Manager
.build/
Packages/**/.build/

# CocoaPods temporary files
Pods/Local Podspecs/

# Logs and coverage
*.log
*.xcresult
coverage/

# Secrets & API Keys
# NOTE: Do NOT commit actual API keys. Use environment variables in CI/CD.
# RawgAPI.plist is tracked but should only contain PLACEHOLDER values.
# Actual API key is injected via RAWG_API_KEY environment variable.
env.local
.env
.env.local
*.key
*.pem
